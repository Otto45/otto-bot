{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "description": "ok.",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ReviewFindingResponse": {
        "properties": {
          "fix": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "severity": {
            "description": "high, medium or low.",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "path",
          "problem",
          "fix"
        ],
        "type": "object"
      },
      "SendMessageRequest": {
        "properties": {
          "text": {
            "description": "What the person wrote.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "ServiceTierRequest": {
        "description": "How fast, and at what price, the model serves the session's requests.",
        "enum": [
          "standard",
          "fast",
          "ultrafast"
        ],
        "type": "string"
      },
      "SessionCreatedResponse": {
        "properties": {
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object"
      },
      "SessionEventResponse": {
        "description": "One of a session's events, as the `data` of a server-sent event whose `id` is its number. A run starts with\n`run_started` and ends with exactly one of `run_completed`, `run_failed` or `run_cancelled`; the replies meant\nfor the person are the `assistant_replied` events with `to_person` set.",
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "run_started"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "agent": {
                "description": "orchestrator, or the lane of the agent (e.g. implementor_1).",
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "to_person": {
                "description": "Whether it is said to the person (the orchestrator's): in plain words, for a person who isn't technical.",
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "assistant_replied"
                ],
                "type": "string"
              }
            },
            "required": [
              "agent",
              "to_person",
              "text",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "agent": {
                "type": "string"
              },
              "succeeded": {
                "type": "boolean"
              },
              "target": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "tool_used"
                ],
                "type": "string"
              }
            },
            "required": [
              "agent",
              "tool_name",
              "target",
              "succeeded",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "decisions": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "done_when": {
                "type": "string"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "task": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "brief_accepted"
                ],
                "type": "string"
              }
            },
            "required": [
              "task",
              "decisions",
              "done_when",
              "files",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "checks_passed": {
                "type": "boolean"
              },
              "fixed_after_review": {
                "type": "boolean"
              },
              "needs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "review_findings": {
                "items": {
                  "$ref": "#/components/schemas/ReviewFindingResponse"
                },
                "type": "array"
              },
              "status": {
                "description": "done or blocked; none when the implementor finished without reporting.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "enum": [
                  "brief_implemented"
                ],
                "type": "string"
              }
            },
            "required": [
              "needs",
              "checks_passed",
              "review_findings",
              "fixed_after_review",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "agent": {
                "type": "string"
              },
              "input_tokens": {
                "format": "int64",
                "type": "integer"
              },
              "output_tokens": {
                "format": "int64",
                "type": "integer"
              },
              "type": {
                "enum": [
                  "lane_compacted"
                ],
                "type": "string"
              }
            },
            "required": [
              "agent",
              "input_tokens",
              "output_tokens",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "cached_input_tokens": {
                "format": "int64",
                "type": "integer"
              },
              "input_tokens": {
                "format": "int64",
                "type": "integer"
              },
              "output_tokens": {
                "format": "int64",
                "type": "integer"
              },
              "service_tier": {
                "description": "The tier the last response ran at, if the API said.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "turns": {
                "format": "int64",
                "type": "integer"
              },
              "type": {
                "enum": [
                  "run_completed"
                ],
                "type": "string"
              }
            },
            "required": [
              "turns",
              "input_tokens",
              "cached_input_tokens",
              "output_tokens",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "run_failed"
                ],
                "type": "string"
              }
            },
            "required": [
              "error",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "run_cancelled"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "SessionListResponse": {
        "properties": {
          "sessions": {
            "description": "Most recently active first.",
            "items": {
              "$ref": "#/components/schemas/SessionSummaryResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "SessionSummaryResponse": {
        "properties": {
          "first_request": {
            "description": "The person's first message, if they have sent one.",
            "type": [
              "string",
              "null"
            ]
          },
          "last_active_on": {
            "description": "When the person or otto last said anything, or when it started.",
            "format": "date-time",
            "type": "string"
          },
          "request_count": {
            "description": "How many messages the person has sent.",
            "minimum": 0,
            "type": "integer"
          },
          "service_tier": {
            "description": "standard, fast or ultrafast.",
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "started_on": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "service_tier",
          "started_on",
          "last_active_on",
          "request_count"
        ],
        "type": "object"
      },
      "StartAppRequest": {
        "properties": {
          "name": {
            "description": "The app's name, in any form (e.g. \"Orders App\"); its kebab-case form (orders-app) names it from then on.",
            "type": "string"
          },
          "stack": {
            "description": "The stack it is built in: rust, python, typescript or web.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "stack"
        ],
        "type": "object"
      },
      "StartSessionRequest": {
        "properties": {
          "service_tier": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ServiceTierRequest",
                "description": "The tier the session runs at [default: the server's configured tier]."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "StartedAppResponse": {
        "properties": {
          "file_count": {
            "description": "How many files it started with, from its stack's template.",
            "minimum": 0,
            "type": "integer"
          },
          "formatted": {
            "description": "Whether the stack's formatters ran over it.",
            "type": "boolean"
          },
          "name": {
            "description": "The app's kebab-case name, which addresses it from now on (e.g. orders-app).",
            "type": "string"
          },
          "stack": {
            "type": "string"
          },
          "title": {
            "description": "The app's name as a title (e.g. Orders App).",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "stack",
          "file_count",
          "formatted"
        ],
        "type": "object"
      },
      "TranscriptMessageResponse": {
        "properties": {
          "said_on": {
            "format": "date-time",
            "type": "string"
          },
          "speaker": {
            "description": "person or assistant.",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "speaker",
          "text",
          "said_on"
        ],
        "type": "object"
      },
      "TranscriptResponse": {
        "properties": {
          "messages": {
            "description": "Oldest first, in plain words: what the person wrote and what otto answered.",
            "items": {
              "$ref": "#/components/schemas/TranscriptMessageResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "otto-bot",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/apps": {
      "post": {
        "operationId": "start_app",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartAppRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedAppResponse"
                }
              }
            },
            "description": "The app was started from its stack's template"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The name can't be an app's, or there is no such stack"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An app of that name already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The body does not fit the request model"
          }
        }
      }
    },
    "/apps/{app_name}/sessions": {
      "get": {
        "operationId": "list_app_sessions",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponse"
                }
              }
            },
            "description": "The app's sessions, most recently active first"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name"
          }
        }
      },
      "post": {
        "operationId": "start_app_session",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreatedResponse"
                }
              }
            },
            "description": "The session was started"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The body does not fit the request model"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is at its limit of runs, sessions in use or event streams; send this again once one is done"
          }
        }
      }
    },
    "/apps/{app_name}/sessions/{session_id}": {
      "get": {
        "operationId": "get_session",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummaryResponse"
                }
              }
            },
            "description": "The session"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name, or no session of it with that id"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is at its limit of runs, sessions in use or event streams; send this again once one is done"
          }
        }
      }
    },
    "/apps/{app_name}/sessions/{session_id}/cancel": {
      "post": {
        "operationId": "cancel_run",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The run under way, if any, is stopping: its end comes as run_cancelled"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name, or no session of it with that id"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is at its limit of runs, sessions in use or event streams; send this again once one is done"
          }
        }
      }
    },
    "/apps/{app_name}/sessions/{session_id}/events": {
      "get": {
        "operationId": "follow_events",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The id of the last event seen: the events kept after it are sent first (as with a Last-Event-ID header).",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The id of the last event seen, as an EventSource sends it when it reconnects",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SessionEventResponse"
                }
              }
            },
            "description": "The session's events as server-sent events, from the current run's start (or after the event named), for as long as the client stays"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name, or no session of it with that id"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is at its limit of runs, sessions in use or event streams; send this again once one is done"
          }
        }
      }
    },
    "/apps/{app_name}/sessions/{session_id}/messages": {
      "get": {
        "operationId": "get_messages",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptResponse"
                }
              }
            },
            "description": "What the person and otto said, oldest first"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name, or no session of it with that id"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is at its limit of runs, sessions in use or event streams; send this again once one is done"
          }
        }
      },
      "post": {
        "operationId": "send_message",
        "parameters": [
          {
            "description": "The app's kebab-case name",
            "in": "path",
            "name": "app_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "otto is working on it: follow the session's events"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The message is empty"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request doesn't bear the service's token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no app of that name, or no session of it with that id"
          },
          "409": {
            "content": {
              "application/json": {
